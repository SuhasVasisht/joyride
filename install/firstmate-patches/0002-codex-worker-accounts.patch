+# fm_worker_codex_account_resolve <config-dir> <id> [<recorded-root>]
+# Prints "id<TAB>root<TAB>" for an explicitly selected Codex account.
+# config/codex-accounts contains one id<TAB>absolute CODEX_HOME per line;
+# ids match [A-Za-z0-9][A-Za-z0-9._-]* and must be unique. A final newline
+# is optional. Empty files, blank lines, comments, CRs, and other control
