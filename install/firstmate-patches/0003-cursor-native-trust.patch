@@ -0,0 +1,88 @@
+#!/usr/bin/env bash
+# Real Cursor native workspace trust and positional brief delivery. Submits
+# prompts, so opt-in. Uses an isolated tmux socket and fresh scratch repos, not
+# the fleet or its worktree pool. Cursor's own per-workspace records remain in
+# ~/.cursor; no credential or global config is changed. FM_CURSOR_BIN may pin a
+# retained installed version; FM_CURSOR_TRUST_LAB_ROOT selects the scratch root.
+set -u
+# shellcheck source=tests/lib.sh
+. "$(dirname "${BASH_SOURCE[0]}")/lib.sh"
+fm_live_gate opt-in FM_CURSOR_TRUST_LIVE tmux jq
+# shellcheck source=bin/fm-backend.sh
+. "$ROOT/bin/fm-backend.sh"
+# shellcheck source=bin/fm-busy-lib.sh
+. "$ROOT/bin/fm-busy-lib.sh"
+# shellcheck source=bin/fm-cursor-lib.sh
+. "$ROOT/bin/fm-cursor-lib.sh"
+CURSOR_BIN=${FM_CURSOR_BIN:-$(fm_cursor_resolve_binary)}
+[ -x "$CURSOR_BIN" ] || fail "cursor missing: $CURSOR_BIN"
+VERSION=$("$CURSOR_BIN" --version) || fail "cursor version probe failed"
+printf '# Cursor %s\n' "$VERSION"
+REAL_TMUX=$(command -v tmux)
+SOCKET="fm-cursor-trust-live-$$"
+LAB=$(mktemp -d "${FM_CURSOR_TRUST_LAB_ROOT:-${TMPDIR:-/tmp}}/fm-cursor-trust.XXXXXX")
+cleanup() {
+  "$REAL_TMUX" -L "$SOCKET" kill-server >/dev/null 2>&1 || true
+  rm -rf "$LAB"
+}
+trap cleanup EXIT
+# Only this private socket is reachable through the production tmux adapter.
+tmux() { "$REAL_TMUX" -L "$SOCKET" "$@"; }
+fm_backend_source tmux || fail "Cursor $VERSION: could not load tmux adapter"
+harness_fail() {
+  tmux capture-pane -p -t "${TARGET:-probe}" -S -0 2>/dev/null || true
+  fail "Cursor $VERSION: $1"
+}
+quote() { printf "'%s'" "${1//\'/\'\\\'\'}"; }
+MODEL=${FM_CURSOR_TRUST_MODEL:-grok-4.7-xhigh}
+for variant in plain mcp; do
+  WORKSPACE="$LAB/$variant"
+  mkdir -p "$WORKSPACE/state"
+  git init -q "$WORKSPACE"
+  if [ "$variant" = mcp ]; then
+    mkdir -p "$WORKSPACE/.cursor"
+    # A configured, harmless server; it must never run because only the workspace
+    # is approved. The sentinel detects accidental blanket MCP approval.
+    printf '#!/usr/bin/env bash\nprintf started > %s\ncat\n' "$(quote "$WORKSPACE/mcp-started")" > "$WORKSPACE/server.sh"
+    jq -n --arg script "$WORKSPACE/server.sh" '{mcpServers:{"trust-guard":{command:"bash",args:[$script]}}}' > "$WORKSPACE/.cursor/mcp.json"
+  fi
+  printf 'Use a shell tool to append exactly "done: %s brief read" followed by a newline to worker.status in this workspace. Then stop. Do not change any other files.\n' "$variant" > "$WORKSPACE/brief.md"
+  TARGET="$variant:worker"
+  LAUNCH="env -u CLAUDECODE -u PI_CODING_AGENT -u GROK_AGENT -u CURSOR_INVOKED_AS $(quote "$CURSOR_BIN") --yolo --model $(quote "$MODEL") --workspace $(quote "$WORKSPACE") 'Read brief.md and follow it exactly.'"
+  tmux new-session -d -s "$variant" -n worker -x 160 -y 50 -c "$WORKSPACE" "$LAUNCH" || harness_fail "launch failed ($variant)"
+  PANE=
+  for ((i=0; i<120; i++)); do
+    PANE=$(fm_backend_visible_capture tmux "$TARGET") || harness_fail "viewport read failed"
+    if KEY=$(fm_cursor_workspace_trust_key "$PANE"); then break; fi
+    sleep 0.25
+  done
+  EXPECT=a
+  if [ "$variant" = mcp ]; then
+    if [ "${KEY:-}" = w ]; then
+      EXPECT=w
+    else
+      printf '# Cursor %s: MCP-configured launch did not offer [w]; exercising its displayed [a] dialog instead\n' "$VERSION"
+    fi
+  fi
+  [ "${KEY:-}" = "$EXPECT" ] || harness_fail "fresh $variant workspace did not show named [$EXPECT] trust action"
+  PANE_PID=$(tmux display-message -p -t "$TARGET" '#{pane_pid}')
+  ANCESTRY=$(bash "$ROOT/bin/fm-harness.sh" ancestry-descent "$PANE_PID")
+  [ "$ANCESTRY" = 'comm cursor' ] || harness_fail "real Cursor process ancestry returned '$ANCESTRY' ($variant)"
+  pass "Cursor $VERSION: real process ancestry identifies comm cursor ($variant)"
+  printf '# %s dialog action [%s]\n' "$variant" "$KEY"
+  printf '%s\n' "$PANE"
+  # Production spawn and recovery call exactly this same readiness gate.
+  fm_cursor_wait_for_working tmux "$TARGET" "$variant" "$WORKSPACE/state" || harness_fail "native trust did not reach brief processing ($variant)"
+  for ((i=0; i<480; i++)); do
+    [ ! -e "$WORKSPACE/mcp-started" ] || harness_fail "workspace-only trust started an MCP server"
+    if [ -f "$WORKSPACE/worker.status" ] && grep -Fxq "done: $variant brief read" "$WORKSPACE/worker.status"; then break; fi
+    sleep 0.25
+  done
+  if [ ! -f "$WORKSPACE/worker.status" ] || ! grep -Fxq "done: $variant brief read" "$WORKSPACE/worker.status"; then
+    harness_fail "worker never appended its brief's status ($variant)"
+  fi
+  [ ! -e "$WORKSPACE/mcp-started" ] || harness_fail "workspace-only trust started an MCP server"
+  pass "Cursor $VERSION: $variant [$EXPECT] approval reached positional brief and status append"
+  tmux kill-session -t "$variant"
+done
+printf '# all Cursor native trust live checks passed (2)\n'
