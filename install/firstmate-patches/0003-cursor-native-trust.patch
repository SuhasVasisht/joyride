@@ -1,5 +1,5 @@
 #!/usr/bin/env bash
-# Cursor executable resolution and Cursor process identity.
+# Cursor executable resolution, process identity, and native workspace trust.
 # Sourced by bin/fm-spawn.sh, bin/fm-harness.sh, bin/fm-busy-lib.sh, and
 # bin/backends/tmux.sh. This file is sourced by scripts and has no side effects
 # on source.
@@ -143,6 +143,60 @@ fm_cursor_catalog_has_model() {  # <model>
   '
 }
 
+# Native interactive workspace trust uses the displayed [a]/[w] action, never
+# Enter. --trust remains valid only for print/headless launches. Reads must be
+# viewport-only so a scrolled-away dialog cannot authorize another key.
+fm_cursor_workspace_trust_visible() {  # <plain-viewport>
+  # Cursor retains the completed trust card above its conversation. Its
+  # pending message replaces navigation when approval has already started.
+  case "$1" in
+    *'Use arrow keys to navigate'*) ;;
+    *'Trusting workspace...'*|*'Trusting workspace and applying MCP approvals...'*) return 1 ;;
+  esac
+  case "$1" in
+    *'Workspace Trust Required'*|*'Do you trust the contents of this directory?'*) return 0 ;;
+    *) return 1 ;;
+  esac
+}
+
+fm_cursor_workspace_trust_key() {  # <plain-viewport>
+  local pane=$1
+  fm_cursor_workspace_trust_visible "$pane" || return 1
+  if printf '%s\n' "$pane" | grep -Eq "\[w\][[:space:]]+Trust this workspace, but"; then
+    printf 'w\n'
+  elif printf '%s\n' "$pane" | grep -Eq '\[a\][[:space:]]+Trust this workspace' &&
+    ! printf '%s\n' "$pane" | grep -Eq 'MCP servers|enable all'; then
+    printf 'a\n'
+  else
+    return 1
+  fi
+}
+
+# Wait for this launch to process its positional brief, including relaunches.
+# Answer at most once, and require a cleared viewport plus the running footer
+# or this task's new conversation transcript. Capture errors fail closed.
+# The caller reports failure with the installed Cursor version and cleans up.
+fm_cursor_wait_for_working() {  # <backend> <target> <id> <state-dir> [label]
+  local backend=$1 target=$2 id=$3 state=$4 label=${5:-}
+  local pane key answered=0 verdict i=0 max=${FM_CURSOR_READY_POLLS:-60} interval=${FM_CURSOR_POLL_INTERVAL:-0.5}
+  while [ "$i" -lt "$max" ]; do
+    pane=$(fm_backend_visible_capture "$backend" "$target" "$label") || return 1
+    if fm_cursor_workspace_trust_visible "$pane"; then
+      if [ "$answered" -eq 0 ] && key=$(fm_cursor_workspace_trust_key "$pane"); then
+        fm_backend_send_key "$backend" "$target" "$key" "$label" || return 1
+        answered=1
+      fi
+    elif [ -n "$pane" ]; then
+      case "$pane" in *'ctrl+c to stop'*) return 0 ;; esac
+      verdict=$(fm_busy_classify "$backend" "$target" cursor "$id" "$state" "$pane")
+      case "$verdict" in 'busy cursor-transcript'|'idle cursor-transcript') return 0 ;; esac
+    fi
+    i=$((i + 1))
+    [ "$i" -ge "$max" ] || sleep "$interval"
+  done
+  return 1
+}
+
 # Print the stable absolute launcher path for the Cursor executable, or return 1
 # with a diagnostic on stderr.
 #
@@ -240,4 +294,3 @@ fm_cursor_process_matches() {  # <comm> <args> [argv0]
   case "$comm" in */*) fm_cursor_path_is_cursor "$comm" && return 0 ;; esac
   return 1
 }
