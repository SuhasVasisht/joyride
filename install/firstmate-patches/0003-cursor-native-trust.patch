+    out=$(FM_TEST_CURSOR_GATE="$gate" run_spawn "$HOME_DIR" "$WT_DIR" "$FAKEBIN_DIR" "$LAUNCH_LOG" "$id" "$PROJ_DIR" --scout --harness cursor)
+    status=$?
+    case "$gate" in
+      trust|mcp|trust-card)
+        expect_code 0 "$status" "native trust must reach brief processing: $out"
+        key=a; [ "$gate" != mcp ] || key=w
+        [ "$(cat "$HOME_DIR/cursor-gate.log")" = "$key" ] || fail "native trust must send its named key once"
+        ;;
+      stalled|trust-stalled|stale-footer|unreadable|unknown-action|mcp-missing)
+        expect_code 1 "$status" "no processing proof must refuse: $out"
+        assert_contains "$out" 'did not confirm brief processing' "refusal must name the failed readiness gate"
+        assert_not_contains "$out" "spawned $id" "a stalled Cursor cannot report success"
+        assert_grep 'kill-window' "$HOME_DIR/cursor-gate.log" "failed Cursor endpoint must be closed"
+        if [ "$gate" = trust-stalled ]; then
+          [ "$(grep -c '^a$' "$HOME_DIR/cursor-gate.log")" = 1 ] || fail "an unanswered repeated dialog must get only one key"
+        fi
+        ;;
+    esac
+  done
+  pass "Cursor native trust reaches processing or closes the failed endpoint without repeating approval"
+}
