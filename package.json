{
  "name": "joyride",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local agent workspace: world model, attention, evidence and memory over Herdr + Firstmate",
  "bin": {
    "joyride": "bin/joyride",
    "joyride-evidence": "bin/joyride-evidence"
  },
  "scripts": {
    "start": "tsx src/server/main.ts",
    "dev": "concurrently -k \"tsx watch src/server/main.ts\" \"vite --port 4318\"",
    "build": "vite build",
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run",
    "e2e": "scripts/e2e-all.sh",
    "joyride": "tsx src/cli/joyride.ts",
    "e2e:one": "scripts/e2e.sh"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.3",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "better-sqlite3": "^12.11.1",
    "gray-matter": "^4.0.3",
    "hono": "^4.13.13",
    "nanoid": "^5.1.16",
    "picomatch": "^4.0.7",
    "smol-toml": "^1.9.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/inter-tight": "^5.3.0",
    "@fontsource/newsreader": "^5.3.0",
    "@playwright/test": "^1.63.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.4",
    "@types/picomatch": "^4.0.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^9.2.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^4.1.11"
  }
}
