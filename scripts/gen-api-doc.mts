// Regenerates docs/API.md from the route registrations in src/modules and src/server.
import fs from "node:fs";
import path from "node:path";
const root = path.resolve(path.dirname(new URL(import.meta.url).pathname), "..");
const files: string[] = [];
const walk = (d: string) => { for (const e of fs.readdirSync(d, { withFileTypes: true })) { const p = path.join(d, e.name); if (e.isDirectory()) walk(p); else if (p.endsWith(".ts")) files.push(p); } };
walk(path.join(root, "src/modules")); walk(path.join(root, "src/server"));
const rows: [string, string, string][] = [];
for (const f of files) {
  const src = fs.readFileSync(f, "utf8");
  for (const m of src.matchAll(/app\.(get|post|put|delete)\(\s*"([^"]+)"/g)) if (m[2].startsWith("/api")) rows.push([m[1].toUpperCase(), m[2], path.relative(root, f)]);
}
rows.sort((a, b) => a[1].localeCompare(b[1]) || a[0].localeCompare(b[0]));
const out = ["# HTTP API", "", "Generated by `npx tsx scripts/gen-api-doc.mts` from the route registrations; do not edit by hand. Semantics live in each module and in `docs/CONTRACTS.md`.", "", "| method | path | defined in |", "|---|---|---|", ...rows.map(([m, p, f]) => `| ${m} | \`${p}\` | ${f} |`), ""];
fs.writeFileSync(path.join(root, "docs/API.md"), out.join("\n"));
console.log(`${rows.length} routes -> docs/API.md`);
